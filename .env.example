# Optional — enables live LLM generation via OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Recommended — Kling video via fal.ai (https://fal.ai/dashboard/keys)
FAL_KEY=

# Public URL of this Ghostcut instance (OAuth redirects + IG media fetch)
GHOSTCUT_APP_URL=http://127.0.0.1:43123
# Instagram live publish needs a public HTTPS base Meta can fetch
# GHOSTCUT_PUBLIC_MEDIA_BASE=https://your-deployed-host.example

# Persistent data dir (Fly volume mounts /data — see docs/DEPLOY_FLY.md)
# GHOSTCUT_DATA_DIR=/data

# YouTube OAuth (Google Cloud → OAuth client, YouTube Data API v3)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Instagram / Reels OAuth (Meta app → Instagram Graph + Facebook Login)
META_APP_ID=
META_APP_SECRET=

# Password gate for the deployed app (browser login prompt, any username).
# Strongly recommended on Fly — without it anyone with the URL can post to your channels.
# GHOSTCUT_PASSWORD=
